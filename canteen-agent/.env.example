# ===== MySQL (虚拟机) =====
MYSQL_HOST=192.168.10.20
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=changeme_2024
MYSQL_DATABASE=canteen_agent

# ===== Redis (虚拟机) =====
REDIS_HOST=192.168.10.20
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Milvus (虚拟机) =====
MILVUS_HOST=192.168.10.20
MILVUS_PORT=19530

# ===== OpenAI LLM =====
OPENAI_API_KEY=sk-your-llm-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o

# ===== OpenAI Embedding =====
OPENAI_EMBED_API_KEY=sk-your-embed-key-here
OPENAI_EMBED_BASE_URL=https://api.openai.com/v1
OPENAI_EMBED_MODEL=text-embedding-3-small

# ===== Backend =====
BACKEND_PORT=8000
BACKEND_SECRET_KEY=change-me-to-a-random-string
# Agent 服务地址（backend → agent）
AGENT_INTERNAL_URL=http://agent:8001
# 自动同步间隔（分钟）：backend 定时把「未同步」评论推入分析队列
# 设为 0 关闭自动同步，只保留手动 POST /api/v1/sync
AUTO_SYNC_INTERVAL_MINUTES=5

# ===== Agent 分析消费者 =====
# 消费者回调 backend 写库的地址（agent → backend，容器网络内）
BACKEND_INTERNAL_URL=http://backend:8000
# 单进程并发处理的分片数，多开进程可再叠加
CONSUMER_CONCURRENCY=4

# ===== 推送通道 (v3.0 新增) =====
# 企业微信 Bot Webhook
WECOM_WEBHOOK_URL=
# 钉钉 Bot Webhook + 加签密钥
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
# 邮件 SMTP
SMTP_HOST=
SMTP_PORT=465
SMTP_SENDER=
SMTP_PASSWORD=
SMTP_RECIPIENTS=

# ===== Frontend =====
FRONTEND_PORT=3000
